{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "siegelingstcgtesting",
    "public": "src/main/resources/static",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/js/config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "**/*.@(png|webp|jpg|jpeg|svg|gif|ico|mp3|fbx)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(landing|home|login|social|cards|decks|lobbies|profile|achievements|deck-builder|shop|play|siege|keep|help)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(social|profile|achievements)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/site.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/landing",
        "destination": "/landing.html"
      },
      {
        "source": "/home",
        "destination": "/home-next.html"
      },
      {
        "source": "/cards",
        "destination": "/home-next.html"
      },
      {
        "source": "/decks",
        "destination": "/home-next.html"
      },
      {
        "source": "/deck-builder",
        "destination": "/home-next.html"
      },
      {
        "source": "/shop",
        "destination": "/home-next.html"
      },
      {
        "source": "/shop/cardpack",
        "destination": "/home-next.html"
      },
      {
        "source": "/profile",
        "destination": "/home-next.html"
      },
      {
        "source": "/profile/**",
        "destination": "/home-next.html"
      },
      {
        "source": "/achievements",
        "destination": "/home-next.html"
      },
      {
        "source": "/achievements/**",
        "destination": "/home-next.html"
      },
      {
        "source": "/social",
        "destination": "/home-next.html"
      },
      {
        "source": "/settings",
        "destination": "/home-next.html"
      },
      {
        "source": "/help",
        "destination": "/home-next.html"
      },
      {
        "source": "/next",
        "destination": "/home-next.html"
      },
      {
        "source": "/legacy",
        "destination": "/home.html"
      },
      {
        "source": "/legacy/home",
        "destination": "/home.html"
      },
      {
        "source": "/legacy/cards",
        "destination": "/home.html"
      },
      {
        "source": "/legacy/decks",
        "destination": "/home.html"
      },
      {
        "source": "/legacy/deck-builder",
        "destination": "/home.html"
      },
      {
        "source": "/legacy/social",
        "destination": "/home.html"
      },
      {
        "source": "/legacy/social/**",
        "destination": "/home.html"
      },
      {
        "source": "/legacy/lobbies",
        "destination": "/home.html"
      },
      {
        "source": "/legacy/profile",
        "destination": "/home.html"
      },
      {
        "source": "/legacy/profile/**",
        "destination": "/home.html"
      },
      {
        "source": "/legacy/achievements",
        "destination": "/home.html"
      },
      {
        "source": "/legacy/achievements/**",
        "destination": "/home.html"
      },
      {
        "source": "/legacy/shop",
        "destination": "/home.html"
      },
      {
        "source": "/legacy/shop/cardpack",
        "destination": "/home.html"
      },
      {
        "source": "/legacy/help",
        "destination": "/help.html"
      },
      {
        "source": "/login",
        "destination": "/home.html"
      },
      {
        "source": "/lobbies",
        "destination": "/home.html"
      },
      {
        "source": "/social/lobby/**",
        "destination": "/home.html"
      },
      {
        "source": "/play",
        "destination": "/play.html"
      },
      {
        "source": "/siege",
        "destination": "/adventure.html"
      },
      {
        "source": "/keep",
        "destination": "/keep.html"
      },
      {
        "source": "/api/cards/editor",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/cards/editor/**",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/**",
        "run": {
          "serviceId": "sieglings-tcg-api",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
