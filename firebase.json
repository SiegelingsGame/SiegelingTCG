{
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "siegelingstcgtesting",
    "public": "src/main/resources/static",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/js/config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/landing",
        "destination": "/landing.html"
      },
      {
        "source": "/home",
        "destination": "/home.html"
      },
      {
        "source": "/login",
        "destination": "/home.html"
      },
      {
        "source": "/social",
        "destination": "/home.html"
      },
      {
        "source": "/social/lobby/**",
        "destination": "/home.html"
      },
      {
        "source": "/cards",
        "destination": "/home.html"
      },
      {
        "source": "/decks",
        "destination": "/home.html"
      },
      {
        "source": "/lobbies",
        "destination": "/home.html"
      },
      {
        "source": "/profile",
        "destination": "/home.html"
      },
      {
        "source": "/profile/**",
        "destination": "/home.html"
      },
      {
        "source": "/shop",
        "destination": "/home.html"
      },
      {
        "source": "/play",
        "destination": "/play.html"
      },
      {
        "source": "/api/cards/editor",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/cards/editor/**",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/**",
        "run": {
          "serviceId": "sieglings-tcg-api",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
